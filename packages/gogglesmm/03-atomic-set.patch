Description: Fix the atomic pointer set fallback on ARMv5
 The __sync fallback in the pointer variant of atomicSet casts through
 TPtr, a type that does not exist anywhere in the tree, so every target
 without lock-free pointers fails to compile. Drop the cast.
Author: Logan Russell <me@lrussell.net>
--- a/fox/include/FXAtomic.h
+++ b/fox/include/FXAtomic.h
@@ -809,7 +809,7 @@
 #elif defined(__GNUC__) && defined(__ATOMIC_SEQ_CST) && (__GCC_ATOMIC_POINTER_LOCK_FREE == 2)
   return __atomic_exchange_n(ptr,v,__ATOMIC_SEQ_CST);
 #elif ((__GNUC__ > 4) || ((__GNUC__ == 4) && (__GNUC_MINOR__ >= 1)))
-  return (TPtr)__sync_lock_test_and_set(ptr,v);
+  return __sync_lock_test_and_set(ptr,v);
 #elif (defined(__GNUC__) && defined(__i386__))
   FXptr ret=v;
   __asm__ __volatile__("xchgl %0,(%1)\n\t" : "=r"(ret) : "r"(ptr), "0"(ret) : "memory", "cc");
