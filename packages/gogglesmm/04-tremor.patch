Description: Build Vorbis support against the fixed-point tremor library
 Replace the floating-point libvorbis decoder with tremor, which decodes
 in integer only.
Author: Logan Russell <me@lrussell.net>
--- a/debian/control
+++ b/debian/control
@@ -34,7 +34,7 @@
 		libltdl-dev,
 		libtag-dev (>= 1.9.0),
 		libtiff-dev,
-		libvorbis-dev,
+		libvorbisidec-dev,
 		libwebp-dev,
 		libx11-dev,
 		libxcursor-dev,
--- a/debian/rules
+++ b/debian/rules
@@ -18,6 +18,7 @@
 override_dh_auto_configure:
 	dh_auto_configure $@ --buildsystem=cmake -- \
 	-DCMAKE_LIBRARY_ARCHITECTURE="$(DEB_TARGET_MULTIARCH)" \
+	-DWITH_TREMOR=ON \
 
 %:
 	dh $@ --buildsystem=cmake
