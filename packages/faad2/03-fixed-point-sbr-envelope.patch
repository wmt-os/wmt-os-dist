Description: Fix the fixed-point SBR envelope estimate
 calculate_gain() expects E_curr to be a plain integer, comparing
 log2_int() of it against find_log2_E(). MUL_C() of a real_t sample
 with itself already produces one, so the 2^14 rescale that came with
 the overflow guard undoes a prescale that never happened, leaving
 E_curr 2^14 too large. The guard's limit, on the same scale, rejects
 envelopes at ordinary loudness. Size the limit to what real_t can hold
 and divide by the sample count as before.
Author: Logan Russell <me@lrussell.net>
--- a/libfaad/sbr_hfadj.c
+++ b/libfaad/sbr_hfadj.c
@@ -147,8 +147,7 @@
        before the limit test below can reject an over-range energy. */
     int64_t nrg;
     const real_t half = REAL_CONST(0.5);
-    real_t limit;
-    real_t mul;
+    int64_t limit;
 #else
     real_t nrg;
     const real_t half = 0;  /* Compiler is smart enough to eliminate +0 op. */
@@ -169,8 +168,7 @@
             if (div <= 0)
                 div = 1;
 #ifdef FIXED_POINT
-            limit = div << (30 - (COEF_BITS - REAL_BITS));
-            mul = (1 << (COEF_BITS - REAL_BITS)) / div;
+            limit = (int64_t)div << 30;
 #endif
 
             for (m = 0; m < sbr->M; m++)
@@ -196,7 +194,7 @@
                 if (nrg < -limit || nrg > limit)
                     return 1;
 #ifdef FIXED_POINT
-                sbr->E_curr[ch][m][l] = nrg * mul;
+                sbr->E_curr[ch][m][l] = (real_t)(nrg / div);
 #else
                 sbr->E_curr[ch][m][l] = nrg / div;
 #endif
@@ -230,8 +228,7 @@
                     if (div <= 0)
                         div = 1;
 #ifdef FIXED_POINT
-                    limit = div << (30 - (COEF_BITS - REAL_BITS));
-                    mul = (1 << (COEF_BITS - REAL_BITS)) / div;
+                    limit = (int64_t)div << 30;
 #endif
 
                     for (i = l_i + sbr->tHFAdj; i < u_i + sbr->tHFAdj; i++)
@@ -256,7 +253,7 @@
                     if (nrg < -limit || nrg > limit)
                         return 1;
 #ifdef FIXED_POINT
-                    sbr->E_curr[ch][k - sbr->kx][l] = nrg * mul;
+                    sbr->E_curr[ch][k - sbr->kx][l] = (real_t)(nrg / div);
 #else
                     sbr->E_curr[ch][k - sbr->kx][l] = nrg / div;
 #endif
